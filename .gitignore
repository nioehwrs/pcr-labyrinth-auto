# 本机路径 / 本机环境（绝不入库）
android/local.properties
android/.gradle/
# ★构建用的反馈令牌（随包分发的小号令牌，但仍不入库：泄露面最小）
android/gitee.properties
**/build/
captures/
.cxx/

# 生成物
*.apk
*.aab
*.ap_
*.dex

# 发布产物目录（历史版本安装包放这里分发，不入库）
dist/

# 商店 DP 的离线生成物：tools/gen_shop_dp.py 的中间结果，正式产物是 assets/shop_curves.json
tools/out/

# 运行日志 / 截图（一跑就几 MB，不入库）
logs/
screenshots/

# ★大二进制：huabanxie-server（改名版 frida-server，106MB）
#   2026-10-25 起不再随 APK 走，改由发布仓库的 Release 附件提供（gz 约 42MB）；
#   本地留底在 dist/frida/*.gz（dist/ 已忽略）。留在 assets 里会让 Gitee 附件超 100MB。
android/app/src/main/assets/frida-server-*
android/app/src/main/assets/huabanxie-server-*

# ★发布用 token（等同密码，绝不入库）
#   用通配：还可能有 .gitee_token_issue（专门提 issue 的账号）等派生的份
tools/.gitee_token
tools/.gitee_token*
tools/.github_token
tools/.github_token*

# Python 工具产出的缓存（tools/*.py 会生成）
__pycache__/
*.pyc

# ★设备拉回来的运行日志（tools/lmj_*.txt、*_keys.txt）：一跑就几 MB，
#   而且**可能含账号/凭证信息**，绝不入库。
tools/lmj_*.txt
tools/lmj_*_keys.txt
# 探针脚本的临时产物（截图 / dump 出来的 JSON）—— 就地生成、只用于当时排查
tools/lmj_*.png
tools/lmj_*.json
# 一次性对比分析的输出目录（同 tools/out/）
tools/out_*/

# IDE / 编辑器（本工程用命令行构建，不需要提交 IDE 配置）
.idea/
*.iml
*.iws
.vscode/
*.swp

# 日志、临时文件
*.log
*.hprof
*.tmp
